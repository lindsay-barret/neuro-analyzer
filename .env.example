# Copy this file to .env and fill in your actual values.
# .env is in .gitignore and must NEVER be committed.

# Anthropic API key (required for visual analysis)
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: Anthropic model to use
ANTHROPIC_MODEL=claude-opus-4-7

# Optional: FreeSurfer home (only if using --with-lgi flag)
# Requires obtaining your own academic license from
# https://surfer.nmr.mgh.harvard.edu/registration.html
# FREESURFER_HOME=/usr/local/freesurfer

# Optional: output directory for reports
OUTPUT_DIR=./outputs

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
